{
  "name": "@reliablejs/postgres",
  "version": "0.1.0",
  "description": "PostgreSQL implementation of @reliablejs/core: outbox, inbox, lease, dispatcher.",
  "type": "module",
  "license": "MIT",
  "author": "Don Freddy",
  "homepage": "https://github.com/donfreddy/reliable-nest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donfreddy/reliable-nest.git",
    "directory": "packages/postgres"
  },
  "bugs": {
    "url": "https://github.com/donfreddy/reliable-nest/issues"
  },
  "keywords": ["outbox", "inbox", "postgres", "transactional-outbox", "drizzle"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle/index.d.ts",
      "default": "./dist/drizzle/index.js"
    }
  },
  "files": ["dist", "migrations"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bench": "tsx bench/lease-throughput.ts"
  },
  "dependencies": {
    "@reliablejs/core": "workspace:^",
    "pg": "^8.13.1"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.44.0 || ^0.45.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.16.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "drizzle-orm": "^0.45.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
