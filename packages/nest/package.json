{
  "name": "@reliable/nest",
  "version": "0.1.0",
  "description": "NestJS integration for @reliable/core: ReliableModule, ReliablePublisher, @ReliableConsumer.",
  "type": "module",
  "license": "MIT",
  "author": "Don Freddy",
  "homepage": "https://github.com/donfreddy/reliable-nest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donfreddy/reliable-nest.git",
    "directory": "packages/nest"
  },
  "bugs": {
    "url": "https://github.com/donfreddy/reliable-nest/issues"
  },
  "keywords": ["nestjs", "outbox", "inbox", "transactional-outbox", "reliability"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@reliable/core": "workspace:^",
    "@reliable/postgres": "workspace:^"
  },
  "peerDependencies": {
    "@nestjs-cls/transactional": "^4.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "nestjs-cls": "^7.0.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs-cls/transactional": "^4.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "nestjs-cls": "^7.0.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
