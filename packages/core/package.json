{
  "name": "@reliablejs/core",
  "version": "0.1.0",
  "description": "Pure TypeScript contracts for reliable side-effects. Zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "Don Freddy",
  "homepage": "https://github.com/donfreddy/reliable-nest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donfreddy/reliable-nest.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/donfreddy/reliable-nest/issues"
  },
  "keywords": ["outbox", "inbox", "transactional-outbox", "reliability", "idempotency"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:arch": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.7",
    "dependency-cruiser": "^16.10.0",
    "fast-check": "^3.23.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
